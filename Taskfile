#!/bin/bash
PATH="$PWD/node_modules/.bin":$PATH
set -e

build() {
  set -x
  rm -rf dist
  mkdir dist
  cp -fv src/bin.js dist
  cp -fv README.md LICENSE dist
  # https://esbuild.github.io/api/#target
  pkgroll --target=es2020 --export-condition=node
  jq '.main = "./index.cjs"
    | .types = "./index.d.ts"
    | .exports.".".require = "./index.cjs"
    | .exports.".".types = "./index.d.ts"
    | .typesVersions."*".generate = ["./generate.d.ts"]
    | .exports."./generate".require = "./generate.cjs"
    | .exports."./generate".types = "./generate.d.ts"
    | del(.devDependencies, .scripts, .packageManager)' package.json >dist/package.json
  set +x
}

# Generate @generated from prisma/schema.prisma with each generator option
# switched on and typecheck the result against Prisma Client types
compatibility_check() {
  schema=prisma/schema.prisma
  # Global: the EXIT trap runs after this function returns
  backup=$(mktemp)
  cp "$schema" "$backup"
  trap 'cp "$backup" "$schema"; rm -f "$backup"' EXIT

  set_option() {
    cp "$backup" "$schema"
    sed -i -E "s/^(\s*$1\s*=\s*).*/\1$2/" "$schema"
  }
  regenerate() {
    rm -rf ./@generated
    prisma generate
  }

  set -x
  regenerate && tsc --noEmit

  for option in noAtomicOperations combineScalarFilters requireSingleFieldsInWhereUniqueInput; do
    echo "=== Check $option ==="
    set_option "$option" true
    regenerate && tsc --noEmit
  done

  echo "=== Check reExport ==="
  set_option reExport All
  regenerate && tsc --noEmit

  echo "=== Check emitSingle ==="
  set_option emitSingle true
  regenerate
  tsc --noEmit --skipLibCheck --experimentalDecorators ./@generated/index.ts
  ts-node ./@generated/index.ts

  echo "=== Check emitCompiled ==="
  set_option emitSingle true
  sed -i -E "s/^(\s*emitCompiled\s*=\s*).*/\1true/" "$schema"
  regenerate
  node ./@generated/index.js

  cp "$backup" "$schema"
  regenerate
  prettier --write ./@generated >/dev/null
  set +x
}

"$@"
