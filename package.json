{
  "name": "@quinnjr/prisma-nestjs-graphql",
  "version": "0.0.0-dev",
  "license": "MIT",
  "description": "Generate object types, inputs, args, etc. from prisma schema file for usage with @nestjs/graphql module",
  "bin": {
    "prisma-nestjs-graphql": "bin.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/quinnjr/prisma-nestjs-graphql.git"
  },
  "homepage": "https://github.com/quinnjr/prisma-nestjs-graphql#readme",
  "keywords": [
    "nestjs",
    "graphql",
    "prisma",
    "prisma-generator",
    "nestjs-graphql"
  ],
  "main": "./dist/index.cjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./generate": {
      "require": "./dist/generate.cjs",
      "types": "./dist/generate.d.ts"
    }
  },
  "typesVersions": {
    "*": {
      "generate": [
        "dist/generate.d.ts"
      ]
    }
  },
  "scripts": {
    "build": "sh Taskfile build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "compatibility": "sh Taskfile compatibility_check",
    "example": "node-dev example/main.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint --max-warnings 0 \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "prisma:g": "prisma generate",
    "regen": "rm -rf @generated && pnpm run prisma:g && prettier --write @generated",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@prisma/generator-helper": "5 - 6",
    "await-event-emitter": "^2.0.2",
    "filenamify": "4.X",
    "flat": "5.X",
    "get-relative-path": "^1.0.2",
    "graceful-fs": "^4.2.11",
    "json5": "^2.2.3",
    "lodash": "^4.17.21",
    "outmatch": "^1.0.0",
    "pluralize": "^8.0.0",
    "pupa": "2.X",
    "ts-morph": "11 - 16"
  },
  "devDependencies": {
    "@apollo/server": "^4.11.3",
    "@eslint/compat": "^1.2.5",
    "@eslint/js": "^9.39.5",
    "@nestjs/apollo": "^13.0.1",
    "@nestjs/common": "^11.0.1",
    "@nestjs/core": "^11.0.1",
    "@nestjs/graphql": "^13.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@paljs/plugins": "^8.1.0",
    "@prisma/client": "5 - 6",
    "@types/flat": "^5.0.5",
    "@types/graceful-fs": "^4.1.9",
    "@types/lodash": "^4.17.14",
    "@types/node": "^22.10.7",
    "@types/pluralize": "^0.0.33",
    "@typescript-eslint/eslint-plugin": "^8.20.0",
    "@typescript-eslint/parser": "^8.20.0",
    "@vitest/coverage-v8": "^5.1.1",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "decimal.js": "^10.4.3",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-only-warn": "^1.1.0",
    "eslint-plugin-perfectionist": "^4.6.0",
    "eslint-plugin-regexp": "^2.7.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-plugin-wix-editor": "^3.3.0",
    "globals": "^17.14.0",
    "graphql": "^16.10.0",
    "graphql-scalars": "^1.24.0",
    "graphql-type-json": "^0.3.2",
    "node-dev": "^8.0.0",
    "pkgroll": "^2.6.1",
    "prettier": "^3.4.2",
    "prisma": "5 - 6",
    "prisma-graphql-type-decimal": "^3.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "simplytyped": "^3.3.0",
    "ts-node": "^10.9.2",
    "tslib": "^2.8.1",
    "type-fest": "^4.32.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^5.1.1"
  },
  "bugs": {
    "url": "https://github.com/quinnjr/prisma-nestjs-graphql/issues"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "pnpm@12.11.2"
}
